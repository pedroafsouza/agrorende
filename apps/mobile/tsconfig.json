{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@agrorende/config/tsconfig/react.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "customConditions": ["react-native"],
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@agrorende/contracts": ["../../packages/contracts/src/index.ts"],
      "@agrorende/contracts/*": ["../../packages/contracts/src/*"],
      "@agrorende/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@agrorende/i18n": ["../../packages/i18n/src/index.ts"]
    },
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "app.config.ts"],
  "exclude": ["node_modules"]
}
