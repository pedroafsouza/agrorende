{
  "ci": {
    "collect": {
      "startServerCommand": "tsx scripts/serve.ts --port 3192",
      "startServerReadyPattern": "serving",
      "url": [
        "http://localhost:3192/pt-br/",
        "http://localhost:3192/en/",
        "http://localhost:3192/pt-br/recursos/",
        "http://localhost:3192/pt-br/planos/",
        "http://localhost:3192/pt-br/ajuda/",
        "http://localhost:3192/pt-br/ajuda/erros/first-sync-large/",
        "http://localhost:3192/pt-br/privacidade/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "../../.data/lhci-site"
    }
  }
}
