{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../packages/config/tsconfig/node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": ".."
  },
  "include": ["./*.ts", "./devloop/*.ts"],
  "exclude": ["../node_modules"]
}
