{
  "name": "@agrorende/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/setupTestDb.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../../.env migrations/runner.ts",
    "seed": "tsx --env-file-if-exists=../../.env seed/index.ts",
    "reset": "tsx --env-file-if-exists=../../.env scripts/reset.ts"
  },
  "dependencies": {
    "@agrorende/contracts": "workspace:*",
    "mongodb": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agrorende/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
